{
  "manifest_version": 3,
  "name": "Observatory Tracker Match Collector",
  "version": "0.5.0",
  "description": "Collect selected-player Tracker matches in bounded batches and save validated responses to the signed-in local Observatory.",
  "permissions": [
    "tabs",
    "storage",
    "webRequest",
    "debugger",
    "downloads"
  ],
  "host_permissions": [
    "https://tracker.gg/*",
    "https://api.tracker.gg/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tracker.gg/valorant/profile/riot/*"
      ],
      "js": [
        "collector-mode.js",
        "tracker-match-capture.js",
        "tracker-page.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
